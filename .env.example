# ============================================================================
# Portafolio Profesional — variables de entorno (copia a .env.local)
# ============================================================================
# Nunca subas este archivo con valores reales. Valores ficticios para el repo.

# URL pública del sitio. Se usa para SEO (canonical, Open Graph y sitemap).
# En local: http://localhost:5169
# En Netlify: https://<tu-sitio>.netlify.app
PUBLIC_SITE_URL=http://localhost:5169

# Netlify Forms no requiere variables: el formulario se detecta al desplegar.
